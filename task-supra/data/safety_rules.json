  "rules": [
    {
      "id": "RULE-PT-RAJAN-NSAID",
      "type": "patient_contraindication",
      "enforcement": "hard_block",
      "trigger": {
        "patient": "Rajan"
      },
      "blocks": [
        "NSAID_CLASS"
      ],
      "source": "SUPRA-KB-002",
      "message": "Patient Rajan has an ABSOLUTE contraindication to all NSAIDs (ibuprofen, aspirin, diclofenac and class). Cardiac stent 2022, on dual antiplatelet therapy. 8 previous refusals documented; family requests must also be refused firmly.",
      "safe_alternative": "Paracetamol 650mg QDS (Supra formulary brand: Calpol / Dolo). Escalate to Tramadol 50mg if pain remains severe. Discuss with Cardiology before any change to antiplatelet therapy."
    },
    {
      "id": "RULE-POSTTKR-NSAID",
      "type": "procedure_contraindication",
      "enforcement": "hard_block",
      "trigger": {
        "any_term": [
          "post-tkr",
          "post tkr",
          "tkr",
          "total knee replacement",
          "knee replacement",
          "arthroplasty"
        ]
      },
      "blocks": [
        "NSAID_CLASS"
      ],
      "source": "SUPRA-KB-001",
      "message": "Supra Ortho prohibits NSAIDs at ALL steps of post-TKR analgesia due to surgical bleeding risk (Dr. Vikram, January 2025).",
      "safe_alternative": "Paracetamol 650mg QDS first-line; escalate to Tramadol 50mg if VAS > 6."
    },
    {
      "id": "RULE-WARFARIN-NSAID",
      "type": "drug_interaction",
      "enforcement": "hard_block",
      "trigger": {
        "any_term": [
          "warfarin",
          "coumadin",
          "inr",
          "anticoagulated",
          "blood thinner"
        ]
      },
      "blocks": [
        "NSAID_CLASS"
      ],
      "source": "SUPRA-KB-010",
      "message": "CRITICAL interaction: NSAIDs must NEVER be prescribed to a patient on Warfarin - risk of life-threatening GI bleed.",
      "safe_alternative": "Paracetamol for pain."
    },
    {
